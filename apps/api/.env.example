PORT=3001

NODE_ENV=development

APP_NAME=OmniPost

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnipost?schema=public"

# JWT Configuration
JWT_ACCESS_SECRET="your-jwt-access-secret-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-at-least-32-characters"
JWT_REFRESH_EXPIRES_IN="7d"

# Token Encryption Configuration (32 bytes / 64 hex characters)
SOCIAL_TOKEN_ENCRYPTION_KEY="your-32-byte-hex-encryption-key-64-characters-long"

# TikTok OAuth v2 & Content Posting API Configuration
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
TIKTOK_REDIRECT_URI="http://localhost:3001/api/social-accounts/tiktok/callback"
TIKTOK_SCOPES="user.info.basic,user.info.profile,video.publish"
TIKTOK_API_BASE_URL="https://open.tiktokapis.com/v2"
TIKTOK_API_TIMEOUT_MS=10000
TIKTOK_MEDIA_POLL_INTERVAL_MS=2000
TIKTOK_MEDIA_POLL_MAX_ATTEMPTS=30

# Instagram Login / Instagram API Configuration
INSTAGRAM_CLIENT_ID="your-instagram-app-client-id"
INSTAGRAM_CLIENT_SECRET="your-instagram-app-client-secret"
INSTAGRAM_REDIRECT_URI="http://localhost:3001/api/social-accounts/instagram/callback"
INSTAGRAM_SCOPES="instagram_business_basic,instagram_business_content_publish"
INSTAGRAM_API_VERSION="v21.0"
INSTAGRAM_API_BASE_URL="https://graph.instagram.com"
INSTAGRAM_API_TIMEOUT_MS=15000
INSTAGRAM_MEDIA_POLL_INTERVAL_MS=2000
INSTAGRAM_MEDIA_POLL_MAX_ATTEMPTS=30

# OAuth Frontend Redirect URLs
OAUTH_SUCCESS_REDIRECT="http://localhost:3000/social-accounts?status=success"
OAUTH_ERROR_REDIRECT="http://localhost:3000/social-accounts?status=error"

# Media Storage Configuration
MEDIA_STORAGE_ROOT="./storage/media"
MEDIA_PUBLIC_BASE_URL="http://localhost:3001/api/media"
MEDIA_MAX_FILE_SIZE_MB=50
